<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal stdout-only log4j2 config for the local demo: the shipped template routes only to
     a rolling file under CELEBORN_LOG_DIR, which is silent in our redirected-stdout setup. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="stdout" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss,SSS} %p [%t] %c{1}: %m%n%ex"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- DEBUG here, not just INFO: OptimizeSkewedJoin's own logDebug calls (size-info dumps,
             skewed-partition counts) are the fastest way to see WHY AQE did or didn't skew-split
             a given run, without patching Spark to add printlns for a question this project only
             needs to answer once. -->
        <Logger name="org.apache.spark.sql.execution.adaptive" level="DEBUG" additivity="false">
            <AppenderRef ref="stdout"/>
        </Logger>
        <Root level="INFO">
            <AppenderRef ref="stdout"/>
        </Root>
    </Loggers>
</Configuration>
